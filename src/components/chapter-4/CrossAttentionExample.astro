---
import { readFileSync } from 'node:fs';
import { Code } from 'astro:components';
import { withBasePath } from '../../utils/paths.js';

const path = '/labs/cross_attention.py';
const source = readFileSync(`public${path}`, 'utf8').trimEnd();
const label = Astro.props.lang === 'ko' ? '파이토치 예제 내려받기' : 'Download the PyTorch example';
---

<p><a href={withBasePath(path)} download="cross_attention.py">{label} (cross_attention.py)</a></p>
<Code code={source} lang="python" theme="github-dark" />
