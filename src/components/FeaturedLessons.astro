---
import { withPagePath } from '../utils/paths.js';
const { lang = 'en' } = Astro.props;
const ko = lang === 'ko';
const lessons = [
  { path: '/chapter-12/kv-cache-management', fragment: ko ? '계산-예제-열-번째-요청은-들어가지-않는다' : 'worked-example-the-tenth-request-does-not-fit', label: ['Serving', '서빙'], title: ['The model fits. Why does the next request run out of memory?', '모델은 올라갔는데, 왜 다음 요청에서 메모리가 부족할까?'], detail: ['Calculate KV cache growth as context, batch size, and KV heads change.', '문맥 길이·배치 크기·KV 헤드 수를 바꾸며 캐시 메모리를 계산합니다.'] },
  { path: '/chapter-3/self-attention-mathematics', fragment: ko ? '예제-어텐션-가중치-행렬' : 'example-attention-weight-matrix', label: ['Attention', '어텐션'], title: ['What does an attention weight actually do?', '어텐션 가중치는 실제로 무엇을 할까?'], detail: ['Follow a query through dot products, masking, softmax, and a weighted sum.', '쿼리 하나를 따라 내적·마스킹·softmax·가중합을 연결합니다.'] },
  { path: '/chapter-14/rag-failure-modes-and-operational-design', fragment: 'trace-a-rag-answer', label: ['Retrieval', '검색'], title: ['Your RAG answer is wrong. Which stage failed?', 'RAG 답변이 틀렸다. 어느 단계의 문제일까?'], detail: ['Trace evidence through retrieval, reranking, context packing, and generation.', '검색·재순위화·문맥 구성·생성 과정에서 근거가 어디서 사라지는지 추적합니다.'] },
  { path: '/chapter-17/experimental-design-and-uncertainty', fragment: 'release-lab', label: ['Evaluation', '평가'], title: ['A higher score is not yet a release decision.', '점수가 올랐다고 바로 배포해도 될까?'], detail: ['Run a paired evaluation and see when uncertainty changes Pass to Review.', '대응 평가를 실행하고 불확실성 때문에 통과가 재검토로 바뀌는 조건을 살펴봅니다.'] },
];
const i = ko ? 1 : 0;
---
<section class="featured-lessons" aria-labelledby="featured-lessons-title">
  <h2 id="featured-lessons-title">{ko ? '궁금한 문제부터 읽어보세요' : 'Start with a problem you care about'}</h2>
  <p>{ko ? '책 전체를 순서대로 읽을 필요는 없습니다. 각 장에는 설명, 예제, 이해를 점검할 퀴즈가 있습니다.' : 'You can read a single lesson. Each one includes an explanation, examples, and questions to test your understanding.'}</p>
  <ul>
    {lessons.map(lesson => (
      <li><a href={withPagePath(`${ko ? '/ko' : ''}${lesson.path}`) + `#${encodeURIComponent(lesson.fragment)}`}>
        <span class="topic">{lesson.label[i]}</span>
        <strong>{lesson.title[i]}</strong>
        <span class="detail">{lesson.detail[i]}</span>
        <span class="read">{ko ? '읽고 실험하기 →' : 'Read and experiment →'}</span>
      </a></li>
    ))}
  </ul>
</section>
<style>
  .featured-lessons { margin: 2.25rem 0; }
  ul { padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  li { margin: 0; }
  a { display: flex; flex-direction: column; height: 100%; box-sizing: border-box; gap: .65rem; border: 1px solid #cbd5e1; border-top: 3px solid #2563eb; border-radius: .5rem; padding: 1.2rem; text-decoration: none; color: #172554; background: #f8fafc; }
  a:hover { background: #eff6ff; border-color: #2563eb; }
  a:focus-visible { outline: 3px solid #2563eb; outline-offset: 3px; }
  .topic { font-size: .8rem; letter-spacing: .04em; text-transform: uppercase; color: #475569; }
  strong { font-size: 1.14rem; line-height: 1.45; }
  .detail { color: #475569; font-size: .95rem; line-height: 1.6; }
  .read { margin-top: auto; padding-top: .4rem; font-size: .9rem; color: #1d4ed8; }
  @media (max-width: 640px) { ul { grid-template-columns: 1fr; } }
</style>
